# 复制为 .env，填写本机路径；.env 不提交。
# Windows 反斜杠按原样填写，路径可用单引号或双引号包裹。
# 不支持变量展开或行尾注释；请把注释放在独立行。
PROBABLY_STOLEN_GAME_ROOT=

# 以下为可选项，供 Scripts/Publish-WorkshopMod.ps1 发布创意工坊使用。
# steamcmd.exe 完整路径；留空则使用 Scripts/Install-SteamCmd.ps1 安装到仓库 Tools/SteamCMD/ 的版本，再从 PATH 查找。
STEAMCMD_PATH=
# Steam 登录账号；留空则运行时询问。密码不要写在这里，由 SteamCMD 交互输入。
STEAM_USERNAME=
